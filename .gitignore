.env
.env.local
*.pyc
__pycache__/
.venv/
venv/
node_modules/
.DS_Store
*.log

# Leftover of the old staged-build-context workflow, which copied a sibling
# uppr_hermes checkout in here. The base is vendored under agent/ now and
# nothing writes this any more — the line stays so an old local copy can't be
# committed by accident. Safe to `rm -rf .build`.
.build/

# Jira ticket drafts written by jira_create_ticket's dry run. They contain
# verbatim customer questions — treat as customer data, keep out of git.
# `mkdir -p .jira-dryrun` before the first `docker compose up`: it is a bind
# mount, and a missing bind source is created by the Docker daemon as root,
# leaving the drafts unreadable without sudo.
.jira-dryrun/

# Import workbooks a customer sent in, mounted into the agent for
# import_check to read. Same reasoning as .jira-dryrun: customer data, and in
# this case their actual object and address records. Never commit these.
.uploads/

# Answers from scripts/eval-questions.py. The question files under evals/ are
# committed; what the agent replied is run output, and grows every run.
evals/runs/
