# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env && $EDITOR .env
#   python3 scripts/preflight-atlassian.py   # verify the Atlassian block below
#   scripts/stage-build-context.sh           # assemble the agent build context
#   docker compose up -d --build

# ─────────────────────────────────────────────────────────────
# The values to collect from the customer on the day.
# See docs/DAY-OF-CHECKLIST.md for how to get each one.
#
# One Atlassian API token covers both halves of the bot: reading the
# Confluence knowledge base and searching Jira.
# ─────────────────────────────────────────────────────────────

# 1. API token — id.atlassian.com → Security → Create and manage API tokens.
#    Classic tokens start with ATATT; scoped ones start with ATCTT. Treat as
#    a password.
JIRA_API_KEY=

# 2. Account e-mail — the Atlassian account the token belongs to. Atlassian
#    Cloud REST uses Basic auth (email:token), so a wrong e-mail is a 401 even
#    with a valid token. A dedicated service account ("RGS+ Helpdesk Bot")
#    beats a person's account: nothing breaks when someone leaves.
ATLASSIAN_EMAIL=

# 3. Where the site is. Two modes — set exactly one:
#      classic/unscoped token -> ATLASSIAN_SITE_URL, the site root.
#                                No trailing slash, no /jira, no /browse/...
#      scoped token           -> ATLASSIAN_CLOUD_ID (it wins if both are set).
#    Unscoped Atlassian API tokens expired between 2026-03-14 and 2026-05-12,
#    so a token issued before then is probably dead — its replacement is
#    scoped and addressed by cloud id.
ATLASSIAN_SITE_URL=https://klant.atlassian.net
# ATLASSIAN_CLOUD_ID=

# 4. Target project — the helpdesk project key ticket drafts are addressed to,
#    e.g. HELP. preflight-atlassian.py lists the keys the account can see.
JIRA_PROJECT_KEY=

# Optional: comma-separated Confluence space keys holding the knowledge base,
# so search doesn't drag in internal or archived spaces. Empty = search
# everything the account can read (works, just noisier).
#   CONFLUENCE_SPACE_KEYS=KB,FAQ
CONFLUENCE_SPACE_KEYS=

# ─────────────────────────────────────────────────────────────
# LLM provider
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ─────────────────────────────────────────────────────────────
# Bridge (the callable module)
# ─────────────────────────────────────────────────────────────

# Bearer token the RGS+ application sends on every call. Required.
#   openssl rand -hex 32
BRIDGE_API_KEY=

# Browser origins allowed to call the bridge directly (comma-separated).
# Only needed if RGS+'s frontend calls the bridge from the browser; if calls
# go through the RGS+ backend, leave this empty.
CORS_ALLOW_ORIGINS=

# Other agent modules this one may call. Same /v1/chat contract.
#   AGENT_PEERS=ict=http://ict-agent-bridge:8081,sales=https://sales.internal
# Per-peer bearer: AGENT_PEER_KEY_ICT=..., AGENT_PEER_KEY_SALES=...
AGENT_PEERS=

# Path on hermes-webui that accepts a chat message. Confirm the real route
# against a running container with scripts/probe-hermes-api.sh before relying
# on the default.
HERMES_SEND_PATH=/api/session/{session_id}/message
HERMES_TIMEOUT=120

# ─────────────────────────────────────────────────────────────
# Embedding + ports
# ─────────────────────────────────────────────────────────────

# Origins allowed to iframe the agent UI. Empty = framing blocked entirely.
#   EMBED_FRAME_ANCESTORS=https://app.rgsplus.nl https://acceptatie.rgsplus.nl
EMBED_FRAME_ANCESTORS=

AGENT_PORT=8080
BRIDGE_PORT=8081
TZ=Europe/Amsterdam

# Path to the uppr_hermes checkout that provides the base agent image.
# scripts/stage-build-context.sh reads this, copies that checkout into
# .build/agent-context, and overlays this repo's library/ and clients/.
HERMES_CONTEXT=../uppr_hermes
